<mvc:View controllerName="com.lipton.pricevalidation.controller.App"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt">
    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader">
                <Button id="menuButton" icon="sap-icon://menu2" press=".onMenuButtonPress" type="Transparent"/>
                <Title id="appTitle" text="Price Validation"/>
            </tnt:ToolHeader>
        </tnt:header>
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" itemSelect=".onNavigationItemSelect" selectedItem="blockedOrdersItem" expanded="false">
                <tnt:item>
                    <tnt:NavigationList id="mainNavList">
                        <tnt:NavigationListItem id="blockedOrdersItem" text="Blocked Orders" icon="sap-icon://alert" key="BlockedOrders"/>
                        <tnt:NavigationListItem id="clearedOrdersItem" text="Cleared Orders" icon="sap-icon://sys-enter-2" key="ClearedOrders" enabled="false"/>
                        <tnt:NavigationListItem id="kamTeamsPushItem" text="KAM Teams Push" icon="sap-icon://discussion" key="KAMTeamsPush" enabled="false"/>
                        <tnt:NavigationListItem id="priceDataAdminItem" text="Price Data Admin" icon="sap-icon://locked" key="PriceDataAdmin" enabled="false"/>
                    </tnt:NavigationList>
                </tnt:item>
            </tnt:SideNavigation>
        </tnt:sideContent>
        <tnt:mainContents>
            <NavContainer id="navContainer"/>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
