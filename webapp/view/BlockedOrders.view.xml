<mvc:View
    controllerName="com.lipton.pricevalidation.controller.BlockedOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:grid="sap.ui.layout.cssgrid"
    displayBlock="true">

    <Page id="page" title="Blocked Orders">
        <content>
            <VBox id="pageWrap" class="pvPageWrap">

                <!-- Search Toolbar -->
                <OverflowToolbar id="searchToolbar" class="sapUiSmallMarginBottom pvSearchToolbar" height="3rem">
                    <SearchField
                        id="searchField"
                        placeholder="Search by order ID, customer name or number..."
                        width="30rem"
                        search=".onSearch"
                        liveChange=".onSearch"/>
                    <ToolbarSpacer id="searchToolbarSpacer"/>
                    <Button id="refreshBtn" text="Refresh" icon="sap-icon://refresh" type="Ghost" press=".onRefresh"/>
                </OverflowToolbar>

                   <!-- Warning Strip -->
                <MessageStrip
                    id="pageSubtitle"
                    text="{orders>/summary/subtitle}"
                    type="Warning"
                    showIcon="true"
                    class="sapUiSmallMarginBottom"/>


                <!-- Orders GridList -->
                <f:GridList
                    id="ordersGrid"
                    items="{orders>/orders}"
                    showNoData="true"
                    noDataText="No blocked orders found"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"
                    width="98%">
                    <f:customLayout>
                        <grid:GridBasicLayout id="ordersGridLayout" gridTemplateColumns="1fr"/>
                    </f:customLayout>
                    <f:items>
                        <f:GridListItem id="orderItem" type="Inactive" class="sapUiTinyMarginTop">
                            <Panel id="orderPanel" expandable="true" expanded="{orders>expanded}">
                                <headerToolbar>
                                    <OverflowToolbar id="orderPanelToolbar" height="4rem">
                                        <VBox id="orderColOrder" class="sapUiSmallMarginEnd">
                                            <Link id="orderIdLink" text="{orders>id}" press=".onOrderPress"/>
                                            <Text id="orderMeta" text="{= ${orders>company} + ' · ' + ${orders>date}}" class="pvSubText"/>
                                        </VBox>
                                        <VBox id="orderColCustomer" class="sapUiSmallMarginEnd">
                                            <Text id="customerName" text="{orders>customer}"/>
                                            <Text id="customerId" text="{orders>customerId}" class="pvSubText"/>
                                        </VBox>
                                        <ObjectStatus id="itemsBadge" text="{= ${orders>itemsPending} + '/' + ${orders>itemsTotal} + ' pending'}" state="Warning" inverted="true" class="sapUiSmallMarginEnd"/>
                                        <GenericTag id="tagSap" text="SAP Value" class="sapUiSmallMarginEnd">
                                            <ObjectNumber id="sapNum" number="{orders>sapValueStr}" emphasized="false"/>
                                        </GenericTag>
                                        <GenericTag id="tagKam" text="KAM Value" class="sapUiSmallMarginEnd">
                                            <ObjectNumber id="kamNum" number="{orders>kamValueStr}" emphasized="false"/>
                                        </GenericTag>
                                        <GenericTag id="tagDiff" text="Δ Difference" status="Error" class="sapUiSmallMarginEnd">
                                            <ObjectNumber id="diffNum" number="{orders>differenceStr}" state="Error" emphasized="false"/>
                                        </GenericTag>
                                        <ObjectStatus id="notifiedStatus" text="Notified" state="Success" visible="{orders>teamNotified}" class="sapUiSmallMarginEnd"/>
                                        <ToolbarSpacer id="orderToolbarSpacer"/>
                                        <Button id="orderKamBtn" text="All KAM" type="Accept" press=".onOrderAcceptAllKAM" class="sapUiTinyMarginEnd"/>
                                        <Button id="orderSapBtn" text="All SAP" press=".onOrderAcceptAllSAP"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <content>
                                    <Title
                                        id="lineItemsTitle"
                                        text="{= 'LINE ITEMS — ' + ${orders>id} + ' · ' + ${orders>customer}}"
                                        level="H6"
                                        class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom sapUiSmallMarginTop"/>
                                    <Table
                                        id="lineItemsTable"
                                        items="{orders>items}"
                                        showSeparators="All"
                                        fixedLayout="false"
                                        class="sapUiSmallMarginBottom">
                                        <columns>
                                            <Column id="colItemNo"><Text id="lblItemNo" text="ITEM #"/></Column>
                                            <Column id="colMaterial"><Text id="lblMaterial" text="MATERIAL"/></Column>
                                            <Column id="colQty"><Text id="lblQty" text="QTY"/></Column>
                                            <Column id="colSapCs"><Text id="lblSapCs" text="SAP / CS"/></Column>
                                            <Column id="colKamCs"><Text id="lblKamCs" text="KAM / CS"/></Column>
                                            <Column id="colTpmCs"><Text id="lblTpmCs" text="TPM / CS"/></Column>
                                            <Column id="colDiff"><Text id="lblDiff" text="Δ DIFF"/></Column>
                                            <Column id="colStatus"><Text id="lblStatus" text="STATUS"/></Column>
                                            <Column id="colActions"><Text id="lblActions" text="ACTIONS"/></Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem id="lineItem" type="Inactive">
                                                <cells>
                                                    <ObjectIdentifier id="cellItemNo" title="{orders>itemNo}"/>
                                                    <VBox id="cellMaterialBox">
                                                        <Text id="cellMaterial" text="{orders>material}"/>
                                                        <Text id="cellMaterialId" text="{orders>materialId}" class="pvSubText"/>
                                                    </VBox>
                                                    <Text id="cellQty" text="{= ${orders>qty} + ' ' + ${orders>unit}}"/>
                                                    <Text id="cellSapPrice" text="{orders>sapPriceStr}"/>
                                                    <Text id="cellKamPrice" text="{orders>kamPriceStr}"/>
                                                    <Text id="cellTpmPrice" text="{orders>tpmPriceStr}"/>
                                                    <ObjectStatus id="cellDiff" text="{orders>diffStr}" state="Error"/>
                                                    <ObjectStatus id="cellStatus" text="{orders>status}" state="Warning" inverted="true"/>
                                                    <HBox id="cellActions">
                                                        <Button id="itemKamBtn" text="KAM" type="Accept" press=".onItemAcceptKAM" class="sapUiTinyMarginEnd"/>
                                                        <Button id="itemTpmBtn" text="TPM" type="Accept" press=".onItemAcceptTPM" visible="{orders>hasTpm}" class="sapUiTinyMarginEnd"/>
                                                        <Button id="itemSapBtn" text="SAP" press=".onItemAcceptSAP"/>
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </content>
                            </Panel>
                        </f:GridListItem>
                    </f:items>
                </f:GridList>

            </VBox>
        </content>
    </Page>
</mvc:View>
