<mvc:View controllerName="com.lipton.pricevalidation.controller.BlockedOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:grid="sap.ui.layout.cssgrid" displayBlock="true">

    <Page id="page" title="Blocked Orders" showHeader="false">
        <content>
            <VBox id="pageWrap" class="pvPageWrap">

                <!-- Search Toolbar -->
                <OverflowToolbar id="searchToolbar" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom pvSearchToolbar" height="3rem">
                    <Title id="suggestionPanelTitle" text="Blocked Sales Orders" titleStyle="H4" />
                    <ToolbarSpacer id="searchToolbarSpacer"/>
                    <SearchField id="searchField" placeholder="Search by order ID, customer name or number..." width="30rem" search=".onSearch" liveChange=".onSearch"/>

                    <Button id="refreshBtn" text="Refresh" icon="sap-icon://refresh" type="Ghost" press=".onRefresh"/>
                </OverflowToolbar>

                <!-- Warning Strip -->
                <MessageStrip id="pageSubtitle" text="{orders>/summary/subtitle}" type="Warning" showIcon="true" class="sapUiSmallMarginBottom sapUiSmallMarginBeginEnd"/>


                <!-- Orders GridList -->
                <f:GridList id="ordersGrid" items="{orders>/orders}" showNoData="true" noDataText="No blocked orders found" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" width="98%">
                    <f:customLayout>
                        <grid:GridBasicLayout id="ordersGridLayout" gridTemplateColumns="1fr"/>
                    </f:customLayout>
                    <f:items>
                        <f:GridListItem id="orderItem" type="Inactive" class="sapUiTinyMarginTop">
                            <Panel id="orderPanel" expandable="true" expanded="{orders>expanded}">
                                <headerToolbar>
                                    <OverflowToolbar id="orderPanelToolbar" height="4rem">
                                        <Title id="orderIdTitle" class="sapUiTinyMarginEnd" text="{orders>id}" titleStyle="H4"/>
                                        <ObjectStatus id="orderMeta" text="{= ${orders>company} + ' · ' + ${orders>date}}" state="Information"/>
                                        <ToolbarSpacer id="orderToolbarSpacer"/>
                                        <Button id="orderKamBtn" text="All KAM" type="Accept" press=".onOrderAcceptAllKAM" class="sapUiTinyMarginEnd"/>
                                        <Button id="orderSapBtn" class="sapUiSmallMarginEnd" text="All SAP" press=".onOrderAcceptAllSAP"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <content>
                                    <HBox id="orderDetails" wrap="Wrap" class="sapUiSmallMargin" justifyContent="SpaceBetween">
                                        <VBox id="detailCustomer" class="sapUiSmallMarginEnd" width="170px">
                                            <Label id="lblDetailCustomer" text="Customer" design="Bold"/>
                                            <ObjectStatus id="valDetailCustomer" text="{orders>customer}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                            <Text id="customerId" text="{orders>customerId}" class="sapUiTinyMarginTop"/>
                                        </VBox>
                                        <VBox id="detailItems" class="sapUiSmallMarginEnd" width="170px">
                                            <Label id="lblDetailItems" text="Items Pending" design="Bold"/>
                                            <ObjectStatus id="valDetailItems" text="{= ${orders>itemsPending} + '/' + ${orders>itemsTotal}}" class="sapUiTinyMarginTop sapMObjectStatusLarge" state="Warning"/>
                                        </VBox>
                                        <VBox id="detailSap" class="sapUiSmallMarginEnd" width="170px">
                                            <Label id="lblDetailSap" text="SAP Value" design="Bold"/>
                                            <ObjectStatus id="valDetailSap" text="{orders>sapValueStr}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailKam" class="sapUiSmallMarginEnd" width="170px">
                                            <Label id="lblDetailKam" text="KAM Value" design="Bold"/>
                                            <ObjectStatus id="valDetailKam" text="{orders>kamValueStr}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailDiff" class="sapUiSmallMarginEnd" width="170px">
                                            <Label id="lblDetailDiff" text="Δ Difference" design="Bold"/>
                                            <ObjectStatus id="valDetailDiff" text="{orders>differenceStr}" state="Error" class="sapUiTinyMarginTop sapMObjectStatusLarge" />
                                        </VBox>
                                        <VBox id="detailNotified" width="170px">
                                            <Label id="lblDetailNotified" text="Team Notified" design="Bold"/>
                                            <ObjectStatus id="valDetailNotified" text="Notified" state="Success" visible="{orders>teamNotified}" class="sapUiTinyMarginTop sapMObjectStatusLarge" />
                                        </VBox>
                                    </HBox>

                                    <OverflowToolbar id="linesItemsTitleToolbar" height="4rem">
                                        <Title id="lineItemsTitle" text="{= 'LINE ITEMS — ' + ${orders>id} + ' · ' + ${orders>customer}}" titleStyle="H4" class="sapUiSmallMarginBottom sapUiMediumMarginTop"/>
                                    </OverflowToolbar>

                                    <Table id="lineItemsTable" items="{orders>items}" showSeparators="All" fixedLayout="false" class="sapUiSmallMarginBottom">
                                        <columns>
                                            <Column id="colItemNo">
                                                <Text id="lblItemNo" text="ITEM #"/>
                                            </Column>
                                            <Column id="colMaterial">
                                                <Text id="lblMaterial" text="MATERIAL"/>
                                            </Column>
                                            <Column id="colQty">
                                                <Text id="lblQty" text="QTY"/>
                                            </Column>
                                            <Column id="colSapCs">
                                                <Text id="lblSapCs" text="SAP / CS"/>
                                            </Column>
                                            <Column id="colKamCs">
                                                <Text id="lblKamCs" text="KAM / CS"/>
                                            </Column>
                                            <Column id="colTpmCs">
                                                <Text id="lblTpmCs" text="TPM / CS"/>
                                            </Column>
                                            <Column id="colDiff">
                                                <Text id="lblDiff" text="Δ DIFF"/>
                                            </Column>
                                            <Column id="colStatus">
                                                <Text id="lblStatus" text="STATUS"/>
                                            </Column>
                                            <Column id="colActions">
                                                <Text id="lblActions" text="ACTIONS"/>
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem id="lineItem" type="Inactive">
                                                <cells>
                                                    <ObjectIdentifier id="cellItemNo" title="{orders>itemNo}"/>
                                                    <VBox id="cellMaterialBox">
                                                        <Text id="cellMaterial" text="{orders>material}"/>
                                                        <Text id="cellMaterialId" text="{orders>materialId}" class="pvSubText"/>
                                                    </VBox>
                                                    <Text id="cellQty" text="{= ${orders>qty} + ' ' + ${orders>unit}}"/>
                                                    <Text id="cellSapPrice" text="{orders>sapPriceStr}"/>
                                                    <Text id="cellKamPrice" text="{orders>kamPriceStr}"/>
                                                    <Text id="cellTpmPrice" text="{orders>tpmPriceStr}"/>
                                                    <ObjectStatus id="cellDiff" text="{orders>diffStr}" state="Error"/>
                                                    <ObjectStatus id="cellStatus" text="{orders>status}" state="Warning" inverted="true"/>
                                                    <HBox id="cellActions">
                                                        <Button id="itemKamBtn" text="KAM" type="Accept" press=".onItemAcceptKAM" class="sapUiTinyMarginEnd"/>
                                                        <Button id="itemTpmBtn" text="TPM" type="Accept" press=".onItemAcceptTPM" visible="{orders>hasTpm}" class="sapUiTinyMarginEnd"/>
                                                        <Button id="itemSapBtn" text="SAP" press=".onItemAcceptSAP"/>
                                                    </HBox>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </content>
                            </Panel>
                        </f:GridListItem>
                    </f:items>
                </f:GridList>

            </VBox>
        </content>
    </Page>
</mvc:View>
