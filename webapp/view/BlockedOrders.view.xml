<mvc:View controllerName="com.lipton.pricevalidation.controller.BlockedOrders"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page id="page" title="Blocked Orders" showHeader="false">
        <content>
            <VBox id="pageWrap" class="pvPageWrap">

                <!-- Search Toolbar -->
                <OverflowToolbar id="searchToolbar" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom pvSearchToolbar" height="3rem">
                    <Title id="suggestionPanelTitle" text="{= 'Blocked Sales Orders (' + ${orders>/orders/length} + ')'}" titleStyle="H4" />
                    <ToolbarSpacer id="searchToolbarSpacer"/>
                    <SearchField id="searchField" placeholder="Search by order ID, customer name or number..." width="30rem" search=".onSearch" liveChange=".onSearch"/>

                    <Button id="refreshBtn" text="Refresh" icon="sap-icon://refresh" type="Ghost" press=".onRefresh"/>
                </OverflowToolbar>

                <!-- Warning Strip -->
                <MessageStrip id="pageSubtitle" text="{orders>/summary/subtitle}" type="Warning" showIcon="true" class="sapUiSmallMarginBottom sapUiSmallMarginBeginEnd"/>

                <!-- Orders GridList -->
                <f:GridList id="ordersGrid" items="{orders>/orders}" showNoData="true" noDataText="No blocked orders found" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom" width="98%">
                    <f:customLayout>
                        <grid:GridBasicLayout id="ordersGridLayout" gridTemplateColumns="1fr"/>
                    </f:customLayout>
                    <f:items>
                        <f:GridListItem id="orderItem" type="Inactive" class="sapUiTinyMarginTop">
                            <Panel id="orderPanel" expandable="true" expanded="{orders>expanded}">
                                <headerToolbar>
                                    <OverflowToolbar id="orderPanelToolbar" height="4rem">
                                        <ObjectStatus id="orderIdTitle" class="sapMObjectStatusLarge" title="Sales Order Number" text="{orders>id}" state="Information"/>
                                        <ToolbarSpacer id="orderToolbarSpacer"/>
                                        <Button id="orderKamBtn" text="All KAM" type="Accept" press=".onOrderAcceptAllKAM" class="sapUiTinyMarginEnd"/>
                                        <Button id="orderSapBtn" class="sapUiSmallMarginEnd" text="All SAP" press=".onOrderAcceptAllSAP"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <content>
                                    <HBox id="orderDetails" wrap="Wrap" class="sapUiSmallMargin" justifyContent="SpaceBetween">
                                        <VBox id="detailSoldTo" class="sapUiSmallMarginEnd">
                                            <Label id="lblDetailSoldTo" text="Sold to Customer" design="Bold"/>
                                            <ObjectStatus id="valDetailSoldTo" text="{orders>customerId}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailCustomerName" class="sapUiSmallMarginEnd">
                                            <Label id="lblDetailCustomerName" text="Customer Name" design="Bold"/>
                                            <ObjectStatus id="valDetailCustomerName" text="{orders>customer}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailCreationDate" class="sapUiSmallMarginEnd" >
                                            <Label id="lblDetailCreationDate" text="Order Creation Date" design="Bold"/>
                                            <ObjectStatus id="valDetailCreationDate" text="{orders>creationDate}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailPricingDate" class="sapUiSmallMarginEnd" >
                                            <Label id="lblDetailPricingDate" text="Pricing Date" design="Bold"/>
                                            <ObjectStatus id="valDetailPricingDate" text="{orders>pricingDate}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                        <VBox id="detailReqDelivery" width="170px">
                                            <Label id="lblDetailReqDelivery" text="Req. Delivery Date" design="Bold"/>
                                            <ObjectStatus id="valDetailReqDelivery" text="{orders>reqDeliveryDate}" class="sapUiTinyMarginTop sapMObjectStatusLarge"/>
                                        </VBox>
                                    </HBox>

                                    <OverflowToolbar id="linesItemsTitleToolbar" height="4rem">
                                        <Title id="lineItemsTitle" text="{= 'LINE ITEMS (' + ${orders>itemsCount} + ')'}" titleStyle="H4" class="sapUiSmallMarginBottom sapUiMediumMarginTop"/>
                                    </OverflowToolbar>

                                    <Table id="lineItemsTable" items="{orders>items}" showSeparators="All" fixedLayout="true" class="sapUiSmallMarginBottom">
                                        <columns>
                                            <Column id="colItemNo" width="60px">
                                                <Text id="lblItemNo" text="LINE"/>
                                            </Column>
                                            <Column id="colMaterial" width="100px">
                                                <Text id="lblMaterial" text="MATERIAL"/>
                                            </Column>
                                            <Column id="colMaterialDesc" width="220px">
                                                <Text id="lblMaterialDesc" text="MATERIAL DESC"/>
                                            </Column>
                                            <Column id="colQty" width="90px">
                                                <Text id="lblQty" text="QTY"/>
                                            </Column>
                                            <Column id="colLineValueSap" width="130px">
                                                <Text id="lblLineValueSap" text="LINE VALUE SAP"/>
                                            </Column>
                                            <Column id="colUnitPriceSap" width="130px">
                                                <Text id="lblUnitPriceSap" text="UNIT PRICE SAP"/>
                                            </Column>
                                            <Column id="colCustExpectedUnit" width="160px">
                                                <Text id="lblCustExpectedUnit" text="CUST. EXPECTED UNIT PRICE"/>
                                            </Column>
                                            <Column id="colCustExpectedValue" width="160px">
                                                <Text id="lblCustExpectedValue" text="CUST. EXPECTED VALUE / ITEM"/>
                                            </Column>
                                            <Column id="colDiff" width="110px">
                                                <Text id="lblDiff" text="DIFFERENCE"/>
                                            </Column>
                                            <Column id="colComments" width="160px">
                                                <Text id="lblComments" text="KAM COMMENTS"/>
                                            </Column>
                                            <Column id="colStatus" width="130px">
                                                <Text id="lblStatus" text="STATUS"/>
                                            </Column>
                                            <Column id="colActions" width="150px">
                                                <Text id="lblActions" text="KAM ACTION"/>
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem id="lineItem" type="Inactive">
                                                <cells>
                                                    <Text id="cellItemNo" text="{orders>itemNo}"/>
                                                    <Text id="cellMaterialId" text="{orders>materialId}"/>
                                                    <Text id="cellMaterial" text="{orders>material}"/>
                                                    <Text id="cellQty" text="{= ${orders>qty} + ' ' + ${orders>unit}}"/>
                                                    <Text id="cellLineValueSap" text="{path: 'orders>lineValueSap', formatter: '.formatEur'}"/>
                                                    <Text id="cellUnitPriceSap" text="{path: 'orders>unitPriceSap', formatter: '.formatEur'}"/>
                                                    <Text id="cellCustExpectedUnit" text="{path: 'orders>custExpectedUnitPrice', formatter: '.formatEur'}"/>
                                                    <Text id="cellCustExpectedValue" text="{path: 'orders>custExpectedValuePerItem', formatter: '.formatEur'}"/>
                                                    <ObjectStatus id="cellDiff" text="{path: 'orders>difference', formatter: '.formatEur'}" state="Error"/>
                                                    <Button id="cellAddCommentBtn" badgeStyle="Default" text="{= ${orders>comment} ? 'Edit Comment' : 'Add Comment'}" icon="sap-icon://comment" type="Transparent" press=".onAddComment">
                                                        <customData>
                                                            <BadgeCustomData id="commentBadge" key="badge" value="{= ${orders>comment} ? '1' : ''}"/>
                                                        </customData>
                                                    </Button>
                                                    <Select id="cellStatus" selectedKey="pending">
                                                        <items>
                                                            <core:Item id="statusPending" key="pending" text="Pending"/>
                                                            <core:Item id="statusApproved" key="approved" text="Approved"/>
                                                            <core:Item id="statusRejected" key="rejected" text="Rejected"/>
                                                            <core:Item id="statusOnHold" key="on_hold" text="On Hold"/>
                                                            <core:Item id="statusEscalated" key="escalated" text="Escalated"/>
                                                        </items>
                                                    </Select>
                                                    <Select id="cellActions" selectedKey="acceptSap">
                                                        <items>
                                                            <core:Item id="actionAcceptSap" key="acceptSap" text="SAP Price Correct"/>
                                                            <core:Item id="actionAcceptCustExpected" key="acceptCustExpected" text="Accept Customer expected Price"/>
                                                        </items>
                                                    </Select>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </content>
                            </Panel>
                        </f:GridListItem>
                    </f:items>
                </f:GridList>

            </VBox>
        </content>
    </Page>
</mvc:View>
